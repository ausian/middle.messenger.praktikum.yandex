.message-area {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
    width: 100%;

    &__header {
        align-items: center;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        justify-content: space-between;
        padding: .5em;
    }

    &__chat-info {
        align-items: center;
        display: flex;
        gap: .5em;
    }

    &__messages {
        box-sizing: border-box;
        height: calc(100vh - 56px - 69px);
        overflow-y: auto;
    }

    &__empty {
        align-items: center;
        color: var(--color-text-secondary, #6b7280);
        display: flex;
        font-size: .95rem;
        height: 100%;
        justify-content: center;
        text-align: center;
    }

    &__footer form{
        align-items: center;
        border-top: 1px solid var(--color-border);
        box-sizing: border-box;
        display: flex;
        gap: .5em;
        padding: .5em;
        width: 100%;

    }
}
