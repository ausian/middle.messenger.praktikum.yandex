<div class="message-area">
  <div class="message-area__header">
    <div class="message-area__header-left">
      <div class="message-area__chat-info">
        {{#if hasActiveChat}}
          {{{ chatAvatar }}}
        {{/if}}
        <h2 class="message-area__chat-name">{{ chatName }}</h2>
      </div>
    </div>
    <div class="message-area__header-right">{{{ chatOptionsButton }}}</div>
  </div>
  <div class="message-area__messages">
    {{#if hasActiveChat}}
      {{{ MessageList }}}
    {{else}}
      <div class="message-area__empty">Выберите чат или создайте новый</div>
    {{/if}}
  </div>
  <div class="message-area__footer">
    {{{ MessageForm }}}
  </div>
</div>
