<ul class="message-list">
  {{#if isLoading}}
    <li class="message-list__item">
      <div class="message-list__empty">Загрузка сообщений...</div>
    </li>
  {{else if hasItems}}
    {{#each items}}
      <li class="message-list__item">
        {{{ renderBlock this }}}
      </li>
    {{/each}}
  {{else}}
    <li class="message-list__item">
      <div class="message-list__empty">Нет сообщений</div>
    </li>
  {{/if}}
</ul>
