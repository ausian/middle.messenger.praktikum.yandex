.popup {
    align-items: center;
    display: flex;
    inset: 0;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    position: fixed;
    transition: opacity 0.2s ease;
    z-index: 1000;
}

.popup--visible {
    opacity: 1;
    pointer-events: auto;
}

.popup__overlay {
    background: rgb(0 0 0 / 40%);
    inset: 0;
    position: absolute;
}

.popup__container {
    background: var(--color-white, #fff);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 15%);
    box-sizing: border-box;
    color: var(--text-primary, #1e1e1e);
    max-width: min(90vw, 420px);
    padding: 24px;
    position: relative;
    width: 100%;
}

.popup__title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 12px;
}

.popup__message {
    font-size: 0.95rem;
    line-height: 1.4;
    margin: 0;
    word-break: break-word;
}

.popup__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 16px;
}

.popup-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.popup-form__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.popup-form__description {
    color: var(--text-secondary, #5c5c5c);
    font-size: 0.95rem;
    margin: 0;
}

.popup-form__actions {
    align-items: center;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
}

.popup-form__error {
    color: var(--color-danger, #ff2f2f);
    font-size: 0.875rem;
    margin: -4px 0 0;
}

.popup-action {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.popup-action__description {
    color: var(--text-secondary, #5c5c5c);
    font-size: 0.95rem;
    margin: 0;
}

.popup-action__buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.popup-action__footer {
    display: flex;
    justify-content: flex-end;
}

.popup__close {
    align-items: center;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    display: flex;
    font-size: 1.25rem;
    height: 32px;
    justify-content: center;
    padding: 0;
    position: absolute;
    right: 12px;
    top: 12px;
    width: 32px;
}

.popup__close::before {
    content: '\00d7';
}

.popup--success .popup__container {
    border: 1px solid var(--color-success, #4caf50);
}

.popup--error .popup__container {
    border: 1px solid var(--color-danger, #ff2f2f);
}

.popup--info .popup__container {
    border: 1px solid var(--color-secondary, #999);
}

.popup-remove {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.popup-remove__description {
    color: var(--text-secondary, #5c5c5c);
    font-size: 0.95rem;
    margin: 0;
}

.popup-remove__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    margin: 0;
    max-height: 220px;
    overflow-y: auto;
    padding: 0;
}

.popup-remove__item {
    display: flex;
}

.popup-remove__user-button {
    align-items: center;
    background: var(--color-surface, #f5f5f5);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    gap: 12px;
    justify-content: space-between;
    padding: 12px 16px;
    transition: background 0.15s ease, box-shadow 0.15s ease;
    width: 100%;
}

.popup-remove__user-button:disabled {
    cursor: not-allowed;
    opacity: 0.7;
}

.popup-remove__user-button:not(:disabled):hover {
    background: var(--color-white, #fff);
    box-shadow: 0 4px 12px rgb(0 0 0 / 8%);
}

.popup-remove__name {
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.popup-remove__role {
    color: var(--text-secondary, #5c5c5c);
    font-size: 0.85rem;
}

.popup-remove__user {
    align-items: center;
    display: flex;
    flex: 1;
    gap: 12px;
    min-width: 0;
}

.popup-remove__avatar {
    align-items: center;
    background: var(--color-hide, #e5e7eb);
    border-radius: 50%;
    color: var(--bg-elem, #111827);
    display: flex;
    flex: 0 0 40px;
    height: 40px;
    justify-content: center;
    overflow: hidden;
    width: 40px;
}

.popup-remove__avatar img {
    height: 100%;
    object-fit: cover;
    width: 100%;
}

.popup-remove__initial {
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
}

.popup-remove__empty {
    color: var(--text-secondary, #5c5c5c);
    font-size: 0.95rem;
    margin: 0;
}

.popup-remove__footer {
    display: flex;
    justify-content: flex-end;
}
